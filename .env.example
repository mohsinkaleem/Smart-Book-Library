# Copy to `.env` (gitignored) and fill in what you need. Every value here has a
# working default — the app runs with no `.env` at all.

# ── Metadata providers ───────────────────────────────────────────────────────
# Google Books' anonymous quota is small and per-IP, so a bulk catalog run will
# start returning 429s without a key. Open Library needs no key.
# https://developers.google.com/books/docs/v1/using#APIKey
GOOGLE_BOOKS_API_KEY=

# ── LLM (optional) ───────────────────────────────────────────────────────────
# Used by the reading view's analysis panel and by `build_catalog.py --llm`.
# The panel checks `GET /api/reading/llm-status` and stays disabled, with a
# reason, when Ollama is not running or this model is not pulled.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
